# QueenBee's server environment - EXAMPLE ONLY.
#
# Copy to .env.local for local development. Never commit a real value: .env and .env.* are
# gitignored, and no secret belongs in this repository, a client bundle, a log or a fixture.
#
# Every value below is a placeholder. None of them is a working credential.

# Required. PostgreSQL connection string for THIS environment.
# Each environment (development, preview, production) must have its own endpoint and credential.
# Development and tests use a disposable local cluster; see docs/database.md.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/queenbees_dev

# Optional. 'pg' (node-postgres, default for non-Neon hosts) or 'neon-serverless' (WebSocket pool,
# required for interactive transactions on Neon). Left unset, it is inferred from the host.
# DATABASE_DRIVER=pg

# Optional. One of: development, test, preview, production. Defaults to NODE_ENV.
# QUEENBEES_ENV=development

# Optional, test-only escape hatch. When unset, integration tests refuse to run against any
# non-local database host. Do not set this in a deployed environment.
# QUEENBEES_ALLOW_REMOTE_TEST_DB=0

# Optional, security-sensitive. '1' lets the same-origin check trust X-Forwarded-Host and
# X-Forwarded-Proto. Off unless it is exactly 1, in every environment.
# Enable it ONLY after verifying that the reverse proxy overwrites both headers and is the ONLY
# network path to the application: otherwise a client can supply them itself and defeat the check.
# TRUST_PROXY_HEADERS=0
# Optional. Telegram order notifications. The bot token is a server secret: it belongs in the
# environment for THIS deployment, never in the database, the admin UI, a log or a commit.
# When it is absent the integration is simply off: no notification is attempted and the owner
# screen says so. Recipient chat ids are configured in the admin panel, not here.
# TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenValueThatIsNotReal_00000000

# Optional. Where catalog image bytes are delivered from, for a deployment whose build does not
# carry `public/catalog`. The value is an origin plus the bucket prefix - never a secret, and never a
# record's identity: the database stores our own key and `src/lib/images.ts` derives the path.
# Left unset, every image is served from the local directory, which is what development does.
# Set, an image the local directory does not contain is answered with a permanent redirect to the
# bucket (`src/app/catalog/[...path]/route.ts`).
# CATALOG_ASSET_BASE_URL=https://<branch-id>.storage.c-1.ap-southeast-1.aws.neon.tech/catalog

