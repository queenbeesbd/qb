{
  "name": "queenbees-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:catalog": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/check-catalog.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "verify:browser": "node scripts/verify-browser.cjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:status": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db.ts status",
    "db:migrate": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db.ts migrate",
    "db:validate": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db.ts validate",
    "db:grants": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db.ts grants",
    "db:rehearsal": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db-rehearsal.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/staff.ts seed",
    "db:seed:catalog": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-catalog.ts",
    "staff:bootstrap": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/staff.ts bootstrap",
    "staff:list": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/staff.ts list",
    "verify:ui": "node scripts/verify-ui-fixes.cjs",
    "verify:admin": "tsx scripts/verify-admin.ts",
    "verify:storefront": "tsx scripts/verify-storefront.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:db": "node --import tsx --test tests/db/*.test.ts",
    "test:all": "npm run test && npm run test:db",
    "db:seed:delivery": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-delivery.ts",
    "import:zatiq": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/import-zatiq.ts",
    "db:purge:imported-orders": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/purge-imported-orders.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.18.9",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.0",
    "eslint-config-next": "16.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
