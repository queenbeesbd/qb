{
  "name": "queenbees-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "verify:browser": "node scripts/verify-browser.cjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:status": "tsx scripts/db.ts status",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:validate": "tsx scripts/db.ts validate",
    "db:grants": "tsx scripts/db.ts grants",
    "db:rehearsal": "tsx scripts/db-rehearsal.ts",
    "test": "node --import tsx --test tests/unit/*.test.ts",
    "test:db": "node --import tsx --test tests/db/*.test.ts",
    "test:all": "npm run test && npm run test:db"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.18.9",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.0",
    "eslint-config-next": "16.4.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
