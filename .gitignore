# Pi harness state: managed by the tool, not application infrastructure
.pi/

node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store
npm-debug.log*
.eslintcache
coverage/

# Local development PostgreSQL cluster. Repository-external by default; this entry exists so a
# session whose only writable path is the workspace cannot accidentally commit a data directory.
.dev-pg/
.tmp-*/

# Local code-graph index (tool cache, 76MB, regenerable). Never part of the project.
.codegraph/

# Product photography imported from the owner's previous store (about 1.3 GB, 7,700 files). Image
# bytes belong in object storage (ADR 0006), not in git; this local tree exists so the development
# storefront can render them. A deployment needs the object-storage step, not a commit.
public/catalog/zq-*
