# Pi harness state: managed by the tool, not application infrastructure
.pi/

# Another agent harness's local settings, same class as `.pi/`: tool state, not the application.
.commandcode/

node_modules/
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo
.env
.env.*
!.env.example
.DS_Store
npm-debug.log*
.eslintcache
coverage/

# Deployment credentials for the owner's VPS. Never tracked, never printed. The deployment session
# sources this file in a subshell; it is not application configuration.
.vps
.vps*

# Local development PostgreSQL cluster. Repository-external by default; this entry exists so a
# session whose only writable path is the workspace cannot accidentally commit a data directory.
.dev-pg/
.tmp-*/

# Private local storage for uploaded payment screenshots (ADR 0042). Bytes, never committed.
.data/

# Browser-automation artefacts (screenshots, snapshots, session console logs) from local probes.
.playwright-cli/

# Local code-graph index (tool cache, 76MB, regenerable). Never part of the project.
.codegraph/

# Product photography imported from the owner's previous store (about 1.3 GB, 7,700 files). Image
# bytes belong in object storage (ADR 0006), not in git; this local tree exists so the development
# storefront can render them. A deployment needs the object-storage step, not a commit.
public/catalog/zq-*
.vercel

# Design-tool working files (numbers, not application infrastructure)
.taste-skill/
